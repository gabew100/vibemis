     Uint32 sensor_timestamp_us;
     Uint64 last_button_state;
     Uint8 watchdog_counter;
+    SDL_bool sensors_enabled;
+    Uint64 next_imu_request_ms;
 } SDL_DriverSteamDeck_Context;
+
+static SDL_bool RequestDeckIMUReports(SDL_hid_device *dev)
+{
+    Uint8 buffer[HID_FEATURE_REPORT_BYTES + 1] = { 0 };
+    FeatureReportMsg *msg = (FeatureReportMsg *)(buffer + 1);
+    msg->header.type = ID_SET_SETTINGS_VALUES;
+    msg->header.length = sizeof(ControllerSetting);
+    msg->payload.setSettingsValues.settings[0].settingNum = SETTING_IMU_MODE;
+    msg->payload.setSettingsValues.settings[0].settingValue =
+        SETTING_GYRO_MODE_SEND_RAW_ACCEL | SETTING_GYRO_MODE_SEND_RAW_GYRO;
+    return SDL_hid_send_feature_report(dev, buffer, sizeof(buffer)) == sizeof(buffer);
+}
+
+static void RecoverDeckIMUReports(SDL_HIDAPI_Device *device, const SteamDeckStatePacket_t *state)
+{
+    SDL_DriverSteamDeck_Context *ctx = (SDL_DriverSteamDeck_Context *)device->context;
+    Uint64 now;
+
+    if (!ctx->sensors_enabled) {
+        return;
+    }
+    if (state->sAccelX || state->sAccelY || state->sAccelZ ||
+        state->sGyroX || state->sGyroY || state->sGyroZ) {
+        ctx->next_imu_request_ms = 0;
+        return;
+    }
+
+    /* Firmware can stop filling the motion fields while input reports continue. */
+    now = SDL_GetTicks64();
+    if (!ctx->next_imu_request_ms) {
+        ctx->next_imu_request_ms = now + 250;
+    } else if (now >= ctx->next_imu_request_ms) {
+        ctx->next_imu_request_ms = now + 1000;
+        RequestDeckIMUReports(device->dev);
+    }
+}
 
